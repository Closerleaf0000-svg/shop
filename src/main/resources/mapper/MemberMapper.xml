<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.shop.mapper.MemberMapper">

    <!-- 依帳號查詢會員 -->
    <select id="findByUsername"
            parameterType="String"
            resultType="com.example.shop.entity.Member">

        SELECT
            MemberID,
            Username,
            Password,
            Email,
            Phone,
            Role
        FROM "Member"
        WHERE Username = #{username}

    </select>


    <!-- 依 Email 查詢會員 -->
    <select id="findByEmail"
            parameterType="String"
            resultType="com.example.shop.entity.Member">

        SELECT
            MemberID,
            Username,
            Password,
            Email,
            Phone,
            Role
        FROM "Member"
        WHERE Email = #{email}

    </select>


    <!-- 檢查 Email 是否已存在 -->
    <select id="existsByEmail"
            parameterType="String"
            resultType="boolean">

        SELECT EXISTS (
            SELECT 1
            FROM "Member"
            WHERE Email = #{email}
        )

    </select>


    <!-- 新增會員 -->
    <insert id="insert"
            statementType="CALLABLE">

        CALL register_member(
            #{username},
            #{password},
            #{email},
            #{phone}
        )

    </insert>

</mapper>